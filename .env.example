# Environment Variables Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Auth
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=32_urlsafe_base64_encoded_key_for_secrets_storage=

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_qa_agent
# Test Database
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis (Task Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=qa-artifacts
S3_REGION=us-east-1

# AI Model Provider
# Supported: openai, anthropic, gemini, mock
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# GitHub App / OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
