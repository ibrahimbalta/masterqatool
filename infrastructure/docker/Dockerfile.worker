FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/worker/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install --with-deps chromium

COPY services/worker /app/services/worker
COPY services/api /app/services/api
COPY packages /app/packages

ENV PYTHONPATH="/app:/app/services/worker:/app/services/api"

# Non-root unprivileged execution
RUN useradd -u 10001 -m sandboxuser
USER sandboxuser

CMD ["python", "-m", "services.worker.app.main"]
